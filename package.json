{
  "name": "keycloak-theme-auctionbase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "dev:login": "vite",
    "dev:admin": "echo '⚠️  Admin theme preview is not available in dev mode.' && echo '📝 Admin themes are SPAs that need to run inside Keycloak.' && echo '✅ To preview: Build with npm run build-keycloak-theme, then deploy to Keycloak.' && echo '' && VITE_THEME_TYPE=admin vite",
    "dev:account": "echo '⚠️  Account theme preview is not available in dev mode.' && echo '📝 Account themes are SPAs that need to run inside Keycloak.' && echo '✅ To preview: Build with npm run build-keycloak-theme, then deploy to Keycloak.' && echo '' && VITE_THEME_TYPE=account vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build-keycloak-theme": "npm run build && keycloakify build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
